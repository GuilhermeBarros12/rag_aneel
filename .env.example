# ============================================================
# CONFIGURAÇÕES DO PROJETO RAG ANEEL
# ============================================================
# Copie este arquivo para .env e preencha com suas chaves reais:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# O .env NUNCA deve ser commitado no repositório (já está no .gitignore)
# ============================================================

# ── LLM primário: Gemini (Google AI Studio) ──────────────────
# Crie sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# ── LLM fallback: Groq (usado se o Gemini falhar) ────────────
# Crie sua chave em: https://console.groq.com
GROQ_API_KEY=sua_chave_groq_aqui

# ── Vectorstore no Hugging Face Hub ──────────────────────────
# Repositório público com o índice ChromaDB pré-construído
# O pipeline.py baixa automaticamente na primeira execução
HF_REPO_ID=guilhermebarros/rag-aneel-vectorstore

# Token do Hugging Face: deixe vazio para só usar o sistema.
# Necessário apenas para enviar o índice (upload_vectorstore.py), com tipo Write.
# Crie em: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Opcionais (os padrões estão em scripts/config.py) ────────
# Quantos chunks recuperar por pergunta
TOP_K=5
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# MODO_BUSCA=lexica
# POLITICA_REVOGADOS=intermediaria
# EXPANSAO_CONTEXTO=documento
# RERANKER=nenhum
# COHERE_RERANK_MODEL=rerank-v5.0-pro

# ── Outros provedores de LLM (opcionais, todos com plano gratuito) ──
# Usados com LLM_AVALIACAO=<nome> na medição. Veja scripts/config.py.
# Cohere (Command A, feito para RAG): https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=
# Mistral (plano gratuito "Experiment"): https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# OpenRouter (modelos com sufixo :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Modelo local no LM Studio (sem chave): servidor em http://localhost:1234
# LOCAL_MODEL=openai/gpt-oss-20b
